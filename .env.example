DATABASE_URL="postgres://usuario:password@host:5432/db?sslmode=require"
SHADOW_DATABASE_URL=""
SESSION_SECRET="genera-uno-con: openssl rand -base64 32"
ADMIN_EMAIL="admin@simba.local"
ADMIN_PASSWORD="cambiar123"

# Día local del restaurante
APP_TIMEZONE="America/Bogota"
# Hora (0-23) en que termina el día de trabajo. 0 = medianoche
DAY_CUTOFF_HOUR=0

# Moneda (COP = pesos enteros, sin centavos)
APP_CURRENCY="COP"

# Solo para la BD local de prisma dev (PGlite). En producción déjalo vacío.
DATABASE_POOL_MAX=1

# Día en que empieza la semana de pago (0 = domingo ... 6 = sábado). 1 = lunes
PAY_WEEK_START=1

# (Opcional) Días de cierre semanal (0 = domingo ... 6 = sábado), ej. 1 = lunes. Vacío = abre todos los días.
# Si un día de cierre es festivo, abre y cierra al día siguiente. Solo es el valor inicial: se cambia en Configuración.
CLOSED_WEEKDAYS=
# Indicativo para los enlaces de WhatsApp cuando el teléfono no lo trae (57 = Colombia)
PHONE_COUNTRY_CODE=57
# Dirección pública del sitio (enlaces para redes sociales, robots.txt y sitemap)
SITE_URL=https://simba.profiya.com
# (Opcional) Código de verificación de Google Search Console por etiqueta HTML; con verificación por DNS no hace falta
# GOOGLE_SITE_VERIFICATION=
