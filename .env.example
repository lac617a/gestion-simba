DATABASE_URL="postgres://usuario:password@host:5432/db?sslmode=require"
SHADOW_DATABASE_URL=""
SESSION_SECRET="genera-uno-con: openssl rand -base64 32"
ADMIN_EMAIL="admin@simba.local"
ADMIN_PASSWORD="cambiar123"

# Día local del restaurante
APP_TIMEZONE="America/Bogota"
# Hora (0-23) en que termina el día de trabajo. 0 = medianoche
DAY_CUTOFF_HOUR=0

# Moneda (COP = pesos enteros, sin centavos)
APP_CURRENCY="COP"

# Solo para la BD local de prisma dev (PGlite). En producción déjalo vacío.
DATABASE_POOL_MAX=1
