generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String @id @default(cuid())
  email          String @unique
  passwordHash   String
  /// Se incrementa al cambiar la contraseña o cerrar sesión en todos lados:
  /// invalida las cookies de sesión emitidas antes.
  sessionVersion Int    @default(0)
}

/// Ajustes del restaurante editables desde la app (una sola fila, id = 1).
/// Si no existe, se usan los valores de las variables de entorno.
model AppSettings {
  id                  Int      @id @default(1)
  /// Día en que empieza la semana de pago (0 = domingo … 6 = sábado)
  payWeekStart        Int
  /// SIN USO desde 2026-09-28: el restaurante abre de lunes a domingo. Se deja la
  /// columna para no romper la versión publicada; se puede borrar en una migración futura.
  closedWeekdays      Int[]
  /// Horario de atención, informativo: 7 textos "HH:MM-HH:MM" (0 = domingo … 6 = sábado); "" = sin horario.
  /// Filas guardadas antes de 2026-09-28 pueden traer un 8.º valor (festivos) que ya no se usa.
  openingHours        String[] @default([])
  /// Día en que se paga la semana que terminó (0 = domingo … 6 = sábado)
  payDay              Int      @default(1)
  /// WhatsApp del restaurante: a donde la página pública manda reservas y pedidos
  whatsapp            String   @default("3012168273")
  /// Calificación y total de opiniones en Google, escritos a mano (página pública)
  googleRating        Float    @default(4.6)
  googleReviewCount   Int      @default(243)
  /// Días con doble turno (0 = domingo … 6 = sábado): mañana y tarde, con propinas por turno
  doubleShiftWeekdays Int[]    @default([0, 6])
  /// Horario de cada turno: ["HH:MM-HH:MM" de la mañana, "HH:MM-HH:MM" de la tarde] (informativo)
  shiftHours          String[] @default(["11:00-16:00", "17:30-23:30"])
  /// Pago fijo por asistir a una jornada de producción (el excedente va aparte)
  productionPay       Decimal  @default(50000) @db.Decimal(14, 2)
  updatedAt           DateTime @updatedAt
}

/// Intentos fallidos de inicio de sesión, por conexión (ip:...) o por correo (email:...).
model LoginThrottle {
  key            String    @id
  failures       Int
  firstFailureAt DateTime
  lockedUntil    DateTime?
}

enum AttendanceStatus {
  PENDING
  WORKED
  REST // descanso fijo semanal
  EXTRA_REST // descanso extra / permiso
  ABSENT // falta
  LEAVE // vacaciones / incapacidad
}

enum TimeOffType {
  EXTRA_REST
  LEAVE
}

/// Turno que hizo un empleado en un día de doble turno.
enum WorkShift {
  MORNING
  EVENING
  BOTH
}

enum DayStatus {
  OPEN
  CLOSED
}

model Employee {
  id                    String                 @id @default(cuid())
  name                  String
  /// SIN USO desde 2026-09-28 (era texto libre); el puesto está en jobPosition.
  position              String?
  jobPositionId         String?
  jobPosition           JobPosition?           @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  phone                 String?
  hireDate              DateTime?              @db.Date
  /// Días de descanso fijo: 0 = domingo ... 6 = sábado
  restDays              Int[]
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  attendances           Attendance[]
  timeOff               TimeOff[]
  tipShares             TipShare[]
  payments              Payment[]
  productionAttendances ProductionAttendance[]

  @@index([active, name])
}

/// Un día de operación del restaurante. Se crea al abrir la asistencia de esa fecha.
model WorkDay {
  id              String       @id @default(cuid())
  /// Día local del restaurante (APP_TIMEZONE), guardado a medianoche UTC
  date            DateTime     @unique @db.Date
  totalSales      Decimal?     @db.Decimal(14, 2)
  tipsTotal       Decimal?     @db.Decimal(14, 2)
  note            String?
  status          DayStatus    @default(OPEN)
  closedAt        DateTime?
  /// Día de doble turno (se decide al abrir el día según Configuración; se puede cambiar a mano)
  doubleShift     Boolean      @default(false)
  /// Propinas de cada turno (días de doble turno); tipsTotal es la suma
  tipsMorning     Decimal?     @db.Decimal(14, 2)
  tipsEvening     Decimal?     @db.Decimal(14, 2)
  /// Cuándo se cerró el turno de la mañana; mientras tanto se puede cambiar quién lo hizo
  morningClosedAt DateTime?
  createdAt       DateTime     @default(now())
  attendances     Attendance[]
  tipShares       TipShare[]
}

/// Pago hecho a un empleado por los días trabajados (pago diario + propinas)
/// de un rango de fechas. Guarda el monto pagado tal como era al pagar.
/// Los rangos de un mismo empleado no se solapan.
model Payment {
  id         String   @id @default(cuid())
  employeeId String
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date
  amount     Decimal  @db.Decimal(14, 2)
  note       String?
  paidAt     DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, periodFrom, periodTo])
}

/// Excepción manual a la regla de días de cierre: abrir un día que normalmente
/// cierra (open = true) o cerrar un día que normalmente abre (open = false).
model DayOverride {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  open      Boolean
  createdAt DateTime @default(now())
}

/// Reparto de propinas guardado al cerrar el día (se borra al reabrir).
model TipShare {
  id         String   @id @default(cuid())
  workDayId  String
  employeeId String
  amount     Decimal  @db.Decimal(14, 2)
  workDay    WorkDay  @relation(fields: [workDayId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@unique([workDayId, employeeId])
  @@index([employeeId])
}

model Attendance {
  id         String           @id @default(cuid())
  workDayId  String
  employeeId String
  status     AttendanceStatus @default(PENDING)
  note       String?
  /// Pago del día (solo si trabajó). Se captura al cerrar el día.
  dailyPay   Decimal?         @db.Decimal(14, 2)
  /// Turno que hizo (solo días de doble turno y estado Trabajó)
  shift      WorkShift?
  updatedAt  DateTime         @updatedAt
  workDay    WorkDay          @relation(fields: [workDayId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@unique([workDayId, employeeId])
  @@index([employeeId])
}

/// Días libres asignados por adelantado (rango inclusivo).
model TimeOff {
  id         String      @id @default(cuid())
  employeeId String
  type       TimeOffType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  note       String?
  createdAt  DateTime    @default(now())
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate, endDate])
}

enum ReservationStatus {
  CONFIRMED
  ARRIVED
  NO_SHOW
  CANCELLED
}

/// Reservas de mesa (RF-14).
model Reservation {
  id           String            @id @default(cuid())
  date         DateTime          @db.Date
  /// Hora local "HH:MM"
  time         String
  partySize    Int
  /// A nombre de quién está la reserva
  customerName String
  phone        String?
  /// Cumpleaños, aniversario… (texto libre)
  occasion     String?
  /// Persona de la ocasión (ej. el cumpleañero)
  honoree      String?
  note         String?
  status       ReservationStatus @default(CONFIRMED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([date])
}

/// Reseñas de clientes que se muestran en la página pública (copiadas a mano de Google).
model Review {
  id         String   @id @default(cuid())
  /// Nombre como se muestra (ej. "Laura G.")
  author     String
  /// 1 a 5 estrellas
  rating     Int
  text       String
  /// Fecha aproximada de la reseña (para "hace 3 meses")
  reviewedAt DateTime @db.Date
  visible    Boolean  @default(true)
  /// Orden en la página (menor primero)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Puestos del restaurante y su pago diario: se agregan, renombran y quitan en
/// Configuración. Al cerrar el día, el pago de cada empleado se llena con el de su puesto.
model JobPosition {
  id        String     @id @default(cuid())
  name      String     @unique
  dailyPay  Decimal    @db.Decimal(14, 2)
  sortOrder Int        @default(0)
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

/// Jornada de producción / preparación: uno o dos días a la semana (cualquiera) en
/// que algunos empleados ayudan a preparar todo. Queda el historial de quién asistió.
model ProductionDay {
  id        String                 @id @default(cuid())
  date      DateTime               @unique @db.Date
  note      String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  attendees ProductionAttendance[]
}

/// Asistente a una jornada de producción. Cobra el pago fijo + un excedente; se suma al pago semanal (Pagos).
model ProductionAttendance {
  id              String        @id @default(cuid())
  productionDayId String
  employeeId      String
  /// Pago fijo de producción cuando se registró (se guarda: el historial no cambia si luego sube)
  basePay         Decimal       @db.Decimal(14, 2)
  /// Excedente (0 si no hay)
  extraPay        Decimal       @default(0) @db.Decimal(14, 2)
  productionDay   ProductionDay @relation(fields: [productionDayId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id])

  @@unique([productionDayId, employeeId])
  @@index([employeeId])
}
